{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "canadacentral"
    },
    "adminUsername": {
      "type": "string",
      "defaultValue": "azureuser"
    },
    "adminPassword": {
      "type": "secureString"
    }
  },
  "resources": [
    {
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2024-01-01",
      "name": "capacity-vnet",
      "location": "[parameters('location')]",
      "properties": {
        "addressSpace": {
          "addressPrefixes": [
            "10.0.0.0/16"
          ]
        },
        "subnets": [
          {
            "name": "default",
            "properties": {
              "addressPrefix": "10.0.0.0/24"
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Compute/virtualMachineScaleSets",
      "apiVersion": "2024-03-01",
      "name": "aks-kaw-vmss",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard_D2s_v3",
        "tier": "Standard",
        "capacity": 1
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks', 'capacity-vnet')]"
      ],
      "properties": {
        "overprovision": false,
        "singlePlacementGroup": false,
        "platformFaultDomainCount": 1,
        "upgradePolicy": {
          "mode": "Manual"
        },
        "virtualMachineProfile": {
          "storageProfile": {
            "imageReference": {
              "publisher": "Canonical",
              "offer": "ubuntu-24_04-lts",
              "sku": "server",
              "version": "latest"
            },
            "osDisk": {
              "createOption": "FromImage"
            }
          },
          "osProfile": {
            "computerNamePrefix": "vmss",
            "adminUsername": "[parameters('adminUsername')]",
            "adminPassword": "[parameters('adminPassword')]",
            "linuxConfiguration": {
              "disablePasswordAuthentication": false
            }
          },
          "networkProfile": {
            "networkInterfaceConfigurations": [
              {
                "name": "nic-config",
                "properties": {
                  "primary": true,
                  "deleteOption": "Delete",
                  "ipConfigurations": [
                    {
                      "name": "ip-config",
                      "properties": {
                        "subnet": {
                          "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', 'capacity-vnet', 'default')]"
                        }
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      }
    }
  ]
}
